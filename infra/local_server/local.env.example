# Shared environment for local runs. Copy to local.env, fill in your project,
# and `source` it in BOTH terminals (the local server AND `adk web`).
#
#   cp infra/local_server/local.env.example infra/local_server/local.env
#   # edit GOOGLE_CLOUD_PROJECT below, then in each terminal:
#   set -a; source infra/local_server/local.env; set +a
#
# Why both terminals: `adk web` runs the spend_iq orchestrator, which reads the
# *_AGENT_RESOURCE vars from ITS OWN process env to build its sub-agents. The
# local server runs the domain/SQL agents it calls. If these vars are only set
# for the server, spend_iq loads with zero sub-agents and can't delegate.

# ── Required ──────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-sandbox-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── Route Gemini inference through Vertex AI + ADC (not an API key) ──
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# ── BigQuery (direct execution when no MCP toolbox) ───────────
BQ_DATASET=ai_financial_dlp
BQ_LOCATION=US

# ── Loopback: redirect inter-agent HTTP calls to the local server ──
# Terminal 1 (local server) listens here; Terminal 2 (adk web) points at it.
VERTEX_API_BASE=http://127.0.0.1:8001

# ── Sub-agent "resource names" — plain agent keys the local server resolves ──
AUDITOR_AGENT_RESOURCE=auditor_agent
BUYER_AGENT_RESOURCE=buyer_agent
TREND_AGENT_RESOURCE=trend_agent
SUPPLIER_CLASSIFICATION_AGENT_RESOURCE=supplier_classification_agent
CONTRACT_INTELLIGENCE_AGENT_RESOURCE=contract_intelligence_agent
FINANCIAL_LEAKAGE_AGENT_RESOURCE=financial_leakage_agent
SQL_GENERATION_AGENT_RESOURCE=sql_generation_agent
VALIDATION_AGENT_RESOURCE=validation_agent
SQL_EXECUTION_AGENT_RESOURCE=sql_execution_agent
