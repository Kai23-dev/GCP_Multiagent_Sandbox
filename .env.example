# ─────────────────────────────────────────────────────────────
# GCP Multi-Agent Sandbox — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# On Windows PowerShell you can load it with:
#   Get-Content .env | ForEach-Object { $key,$val=$_.split('=',2); Set-Item "env:$key" $val }
# ─────────────────────────────────────────────────────────────

# ── Required: GCP Project Settings ───────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-sandbox-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── Optional: Staging Bucket for ADK Deployments ─────────────
# Defaults to gs://{PROJECT_ID}-agent-staging if not set
AGENT_STAGING_BUCKET=gs://your-project-id-agent-staging

# ── Sub-Agent Resource Names (filled in after deployment) ────
# Run: python scripts/deploy_agents.py
# These will be saved to deployed_agents_state.json automatically

SQL_GENERATION_AGENT_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/ID_HERE
VALIDATION_AGENT_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/ID_HERE
SQL_EXECUTION_AGENT_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/ID_HERE

AUDITOR_AGENT_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/ID_HERE
BUYER_AGENT_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/ID_HERE
TREND_AGENT_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/ID_HERE
SUPPLIER_CLASSIFICATION_AGENT_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/ID_HERE
FINANCIAL_LEAKAGE_AGENT_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/ID_HERE

# Spend IQ is the orchestrator — deploy last
SPEND_IQ_AGENT_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/ID_HERE

# ── BigQuery Settings ─────────────────────────────────────────
BQ_DATASET=ai_financial_dlp
BQ_LOCATION=US

# ── Web App Settings (for the Next.js frontend) ───────────────
NEXT_PUBLIC_AGENT_RESOURCE_NAME=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/SPEND_IQ_ID

# ── Web App Auth (IAP) ────────────────────────────────────────
# When set, the signed IAP JWT assertion is cryptographically verified.
# Format: /projects/PROJECT_NUMBER/global/backendServices/BACKEND_SERVICE_ID
IAP_JWT_AUDIENCE=
# Local dev identity, used ONLY when NODE_ENV != production and no IAP headers
# are present. In production the app fails closed (returns 401).
DEV_USER_EMAIL=developer@example.com

# Optional comma-separated allowlist of known ADK reasoning-engine IDs
# (replaces the previously hardcoded IDs in the agent-engine route).
ADK_AGENT_IDS=
