# Web App — Environment Variables
# Copy this file to .env.local and fill in your values
# .env.local is gitignored — never commit it

# ── GCP Project ───────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=gp-ct-sbox-con-sbp0i2-eyenterp
GOOGLE_CLOUD_LOCATION=us-central1

# ── Spend IQ Agent (Orchestrator) ────────────────────────────
# This is the ONLY agent ID the web app needs.
# The Spend IQ agent internally routes to all sub-agents.
DEFAULT_AGENT_ID=3931281834880532480

# ── Authentication ───────────────────────────────────────────
# For local development, leave this blank.
# gcloud auth application-default login handles auth automatically.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── App Settings ─────────────────────────────────────────────
NODE_ENV=development
